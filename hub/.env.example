# Neon (PostgreSQL database)
# DATABASE_URL=postgresql://...

# Cloudflare R2 (image storage)
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# NextAuth (when you add auth)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Gemini: used by Frame Variator (and other apps) via Hub API so the key never goes to the client.
# Set a new key here if the previous one was leaked; never commit the key.
# GEMINI_API_KEY=

# App URLs when running dev:all (defaults: 5173-5177)
# NEXT_PUBLIC_APP_CINEPROMPT_URL=http://localhost:5173
# NEXT_PUBLIC_APP_POV_URL=http://localhost:5174
# NEXT_PUBLIC_APP_CHRONOS_URL=http://localhost:5175
# NEXT_PUBLIC_APP_SWAG_URL=http://localhost:5176
# NEXT_PUBLIC_APP_AVATAR_URL=http://localhost:5177
